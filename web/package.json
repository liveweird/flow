{
  "name": "flow-web",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:api": "openapi-typescript ../server/src/main/resources/openapi/documentation.yaml -o src/api/schema.ts",
    "check:api": "node scripts/check-api.mjs",
    "lint:api": "spectral lint ../server/src/main/resources/openapi/documentation.yaml --ruleset ../api-guidelines/api-guidelines.spectral.yaml && spectral lint ../api-guidelines/examples/conformant.yaml --ruleset ../api-guidelines/api-guidelines.spectral.yaml"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mantine/core": "^9.6.2",
    "@mantine/form": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@mantine/notifications": "^9.6.2",
    "@mantine/spotlight": "9.6.2",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.103.2",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "6.16.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.1",
    "ajv": "8.20.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.8.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.37.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.25",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
