{
  "name": "flow-web",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0 --cache --cache-strategy content",
    "knip": "knip",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:api": "openapi-typescript ../server/src/main/resources/openapi/documentation.yaml -o src/api/schema.ts",
    "check:api": "node scripts/check-api.mjs",
    "lint:api": "spectral lint ../server/src/main/resources/openapi/documentation.yaml --ruleset spectral.flow.yaml --fail-severity=warn && spectral lint ../api-guidelines/examples/conformant.yaml --ruleset spectral.flow.yaml --fail-severity=warn"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mantine/charts": "9.8.2",
    "@mantine/core": "^9.8.2",
    "@mantine/dates": "9.8.2",
    "@mantine/form": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
    "@mantine/spotlight": "9.8.2",
    "@tabler/icons-react": "^3.53.0",
    "@tanstack/react-query": "^5.108.4",
    "dayjs": "^1.11.23",
    "i18next": "^26.7.1",
    "i18next-browser-languagedetector": "^8.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "6.17.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.3",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "8.20.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.48.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "react-is": "^19"
  }
}
