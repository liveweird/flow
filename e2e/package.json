{
  "name": "flow-e2e",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Browser blackbox E2E tests (Playwright) against the full stack on http://localhost:8084",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:setup": "node --test scripts/stack.test.ts",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "install:browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "check:scenarios": "node scripts/check-scenarios.mjs",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
